{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "astro",
  "nodeVersion": "18.x",
  "env": {
    "NEXT_PUBLIC_BASE_URL": {
      "value": "https://avanintelligence.com"
    },
    "NEXT_PUBLIC_SITE_NAME": {
      "value": "Avan Intelligence"
    }
  },
  "domains": [
    "avanintelligence.com",
    "www.avanintelligence.com"
  ],
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
